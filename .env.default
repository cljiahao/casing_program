# ─── Project ──────────────────────────────────────────────────────────
PROJECT_NAME=Casing Program
PROJECT_VERSION=v1.0.0
# Runtime environment: dev | prod
ENVIRONMENT=dev

# ─── Database ─────────────────────────────────────────────────────────
# Local database name.
DB_NAME=casing
# MES system ID tied to the admin account.
ADMIN_MESID=MES12345
# Admin login username.
ADMIN_USERNAME=user
# Admin login password.
ADMIN_PASSWORD=pass

# ─── Services ─────────────────────────────────────────────────────────
# API key for the ROB service.
ROB_API_KEY=""
# PMSS - Production Management Support System (base API URL).
PMSS_API_URL=""
# CM - Container Management (base API URL).
CM_API_URL=""
